PRENOTAMI_EMAIL=your-email@example.com
PRENOTAMI_PASSWORD=your-password

TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id
TELEGRAM_ENABLED=false

# Text identifying the service row. Change this to match the exact label shown by your embassy.
PRENOTAMI_SERVICE_TEXT=Tourism

# Optional settings
PRENOTAMI_BASE_URL=https://prenotami.esteri.it
CHECK_INTERVAL_MINUTES=10
CHECK_INTERVAL_MINUTES_MIN=10
CHECK_INTERVAL_MINUTES_MAX=15
RUN_ONCE=false
HEADLESS=false
DEBUG_MODE=false
DEBUG_STEP_DELAY_MS=1000
DEBUG_HOLD_SECONDS=30
TIMEZONE=Europe/Rome
ARTIFACTS_DIR=artifacts
LOG_FILE=logs/checker.log
BROWSER_PROFILE_DIR=browser-profile
BROWSER_CHANNEL=chrome
BROWSER_TYPE=edge
BROWSER_MODE=playwright
UIA_NAVIGATION_TIMEOUT_SECONDS=20
MANUAL_LOGIN_TIMEOUT_MINUTES=5
